#!/usr/bin/env bash
# Conventions for this tree: scripts/README.md
set -euo pipefail

# post-merge fires after any merge that updates the working tree — the merge
# half of `git pull`, and also a plain `git merge <branch>`. It re-hoists the
# skill symlinks so a merge that adds, renames, or removes a skill is reflected
# in ~/.claude/skills/ without a manual install run.
#
# NOTE: git does not run post-merge on `git pull --rebase`. After a rebase pull,
# run `bash scripts/install.sh` manually.
#
# Gate map: after a merging pull, names any pulled change under global/hooks/ or scripts/git-hooks/, runs every gate, then install.sh (re-hoist); not triggered by 'git pull --rebase'
#
# A post-merge hook cannot abort the merge: git ignores its exit code, so the
# merge has already completed by the time this runs. A failed re-hoist must
# therefore announce itself rather than scroll past — hence the explicit guard
# below instead of relying on `set -e` to surface it.
#
# Enable with: bash scripts/setup-hooks.sh (points core.hooksPath here).

repo_root="$(git rev-parse --show-toplevel)"

# The settings.json snippet points at this checkout's global/hooks/ directly,
# so a pulled commit that edits a hook changes the live PreToolUse check with
# no re-consent — and core.hooksPath points at scripts/git-hooks/ the same
# way, so a pulled edit to a git hook runs on the next commit, merge, or
# message. Name either, one line, so the change does not scroll past.
# ORIG_HEAD is the pre-merge tip only when the merge set it last; a reset or
# rebase in between moves it, so the range can be stale — the line is a
# prompt to look, never the audit itself. Captured once: a pipe into grep -q
# under pipefail can misreport exactly when there is a change.
hook_changes="$(git diff --name-only ORIG_HEAD HEAD -- global/hooks/ scripts/git-hooks/ 2>/dev/null || true)"
if [ -n "$hook_changes" ]; then
  echo "post-merge: NOTE hook behavior changed — this pull touched: $(printf '%s' "$hook_changes" | tr '\n' ' ')"
fi

# A re-hoist publishes whatever the pull brought in; run the gates first so a
# broken skill or a hook whose rule quietly stopped matching is named before
# it is live. Failures warn rather than abort: git ignores this hook's exit
# code, and the merge has already landed.
#
# Every roster is derived, never hand-kept: the two linters are the
# scripts/*.sh that grade the tree rather than themselves; every other gate is
# a selftest — scripts/*-selftest.sh (lint-skills.sh enforces that pairing, so
# a script landing without one is named there), the git hooks' selftests
# beside this file, and the PreToolUse hooks' the way install.sh derives them:
# every global/hooks/*.sh with an `# Install note:` header line. A hook that
# lands in either directory without a selftest is named below, not silently
# ungated. security-selftest.sh runs here too: its last row grades every
# shipped skill body against the scanner, and a pulled body that acquired a
# flagged phrase is exactly what a merge can bring in.
gates="scripts/lint-skills.sh scripts/lint-adrs.sh"
for s in "$repo_root"/scripts/*-selftest.sh; do
  [ -e "$s" ] || continue
  gates="$gates scripts/$(basename "$s")"
done
for s in "$repo_root"/scripts/git-hooks/*-selftest.sh; do
  [ -e "$s" ] || continue
  gates="$gates scripts/git-hooks/$(basename "$s")"
done
for h in $(grep -l '^# Install note: ' "$repo_root"/global/hooks/*.sh 2>/dev/null); do
  gates="$gates global/hooks/$(basename "$h" .sh)-selftest.sh"
done
for gate in $gates; do
  if [ ! -f "$repo_root/$gate" ]; then
    echo "post-merge: WARN gate missing: $gate — a hook whose selftest was renamed or removed, or a linter this hook names by hand" >&2
  else
    # `|| gate_status=$?`, never a bare call: this file runs under `set -e`,
    # and a bare call that failed would end the hook here — before the WARN,
    # before the remaining gates, and before the re-hoist below.
    gate_status=0
    bash "$repo_root/$gate" >/dev/null 2>&1 || gate_status=$?
    # 2 is not a failure and not a clean. The lint family gives it two
    # meanings — a selftest that graded everything it could reach and left a
    # branch unexercised (root, or a filesystem that ignores modes), or a run
    # with nothing to check — and this loop discards output, so the status is
    # the only thing that can carry either; the line names both.
    if [ "$gate_status" -eq 2 ]; then
      echo "post-merge: WARN $gate exited 2 — a partial (some checks went unexercised) or nothing checked; run 'bash $gate' to see which" >&2
    elif [ "$gate_status" -ne 0 ]; then
      echo "post-merge: WARN $gate failed — run 'bash $gate' to see why" >&2
    fi
  fi
done

echo "post-merge: re-hoisting skills → ~/.claude/skills/"
if ! bash "$repo_root/scripts/install.sh"; then
  echo "post-merge: WARN install.sh failed — run 'bash scripts/install.sh' manually to re-hoist" >&2
fi
