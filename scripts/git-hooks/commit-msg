#!/usr/bin/env bash
# Conventions for this tree: scripts/README.md
set -uo pipefail

# Gate map: re-breaks each body prose line past 72 columns in place and says how many, then rejects a commit whose message still breaks the exact rules in src/committing/references/commit-style.md — the rejection names the rule and the file
#
# commit-msg checks a commit message against the deterministic half of the
# house style in src/committing/references/commit-style.md. The reasoning for
# why the deterministic half is the only half a hook may check lives in the
# ADR that admitted this hook, under docs/adr/.
#
# WHAT IT CANNOT CHECK, and must never be read as covering: whether the subject
# is one logical change, whether the body's "why" was non-obvious enough to
# need writing, the register, and every entry in writing-for-humans'
# tell-catalog.md — and its tell-catalog-shipping.md, which holds the commit
# and PR family, the tells nearest this gate and the ones it reads least.
# Those need a reader. A green run here is a claim about shape, never about
# prose — do not prune commit-style.md against it.
#
# Blocks on the exact rules, with one repair: a body prose line past the wrap
# cap is re-broken in place (githooks(5) lets this hook edit its message file)
# and the hook prints how many lines it folded; what it cannot fold is still
# rejected. A message the skip list below names is never rewritten.
# Warns on the imperative-opener check, which is a wordlist heuristic and will
# not always be right.
#
# Skipped entirely: a commit git is making for a merge, revert, or cherry-pick
# in progress (detected from the git state, not from the subject text), a
# subject git generated for a fixup!/squash!/amend! or a Reapply, and an empty
# message (git aborts that one itself). A subject a person wrote that merely
# begins "Merge " or "Revert " is ordinary prose and is checked.
#
# The style doc yields to a convention the project explicitly declares. This
# hook implements only the commitlint half of that yield, and only for the
# Conventional Commits rule — a wrap width declared in CONTRIBUTING is not
# read, and every other rule still applies.
#
# Rejection lines are written with the "commit-msg: " prefix inline so that a
# pasted line greps back to this file.
#
# IF THIS CHECK IS WRONG: rewrite the message, never the gate. A human can pass
# --no-verify once and say why; an agent may not, and commit-bypass refuses it.
# Unsetting core.hooksPath is not the escape hatch — it silently disables every
# hook in the clone, post-merge included, until setup-hooks.sh is run again. A
# rule that is wrong is a defect to report and fix here, with a selftest row.
#
# NOT INVOKED BY: git cherry-pick, git revert, or a plain git rebase replay, so
# a message any of those brings in is never seen. Inside rebase -i, coverage is
# per-verb: reword fires this, squash does not. This gate is a check on what
# you write, not a guarantee about what reaches the branch.
#
# Enable with: bash scripts/setup-hooks.sh (points core.hooksPath here).

msg_file="${1:?commit-msg: no message file}"
[ -f "$msg_file" ] || exit 0

readonly WRAP=72          # hard cap on the subject and on every body line
readonly AIM=50           # the subject length to aim for, named in the advice
readonly STYLE="src/committing/references/commit-style.md"
# The anchors are the headings verbatim, so a reader who searches the style
# doc for the quoted string lands rather than having to guess a prefix.
readonly SUBJECT_ANCHOR="'## The subject'"
readonly BODY_ANCHOR="'## The body: write one only when the subject cannot carry the why'"
fail=0
warn=0

# Count characters, not bytes. ${#var} counts bytes under a C locale, and this
# repo's prose is dense with em dashes at three bytes each — a 65-column line
# measures 79 and is rejected. Git passes the ambient locale through unchanged,
# so cron, CI, and a container with LANG=C all land here.
if __em="——"; [ ${#__em} -ne 2 ]; then
  for __loc in C.UTF-8 en_US.UTF-8 UTF-8; do
    export LC_ALL="$__loc"
    [ ${#__em} -eq 2 ] && break
  done
fi
unset __em __loc

# A commit git is making to conclude a merge, revert, or cherry-pick carries a
# message git generated, which the author cannot freely reword — and rejecting
# it strands the operation resolved but uncommitted. Git records each of these
# as a file in the git dir, which is what this asks; the older subject-text
# test both missed real merges and exempted ordinary prose beginning "Merge ".
git_dir="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
for state in MERGE_HEAD REVERT_HEAD CHERRY_PICK_HEAD; do
  [ -e "$git_dir/$state" ] && exit 0
done

# Git's own comment lines and the scissors block are not the message. The
# comment string is configurable, so it is read rather than assumed; 'auto'
# is treated as '#'. Git 2.45 made `core.commentString` an alias of
# `core.commentChar` (`git help config`: "these two variables are aliases of
# each other"), and the two share one slot: whichever git READ LAST wins,
# whatever its name — measured 2026-09-01 on git 2.50.1 with `git stripspace
# -s` under a local config carrying both in each order. `git config --get
# core.commentChar` cannot see a value set under the other name, so this
# reads both through one regexp and takes the last line, which is git's own
# read order (system, global, local, worktree, command line). The pattern
# stops short of a doubled comment string — stripping every '#' line would
# delete the markdown headings this hook exists to reject. A level-one
# '# Summary' is the one ambiguous case and is treated as a git comment,
# which is the safe way round: a stray comment must never abort a commit.
# Note that a -m commit uses cleanup mode 'whitespace', which strips no
# comments, so a body line opening '#' is dropped here and kept by git — the
# one case where this hook sees less than git commits.
comment_char="$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null | awk '{ v = $2 } END { print v }' || true)"
case "$comment_char" in ''|auto) comment_char='#' ;; esac

# read_message: sets body_all (the message with git's comments and the verbose
# diff dropped, CRs and leading blank lines stripped) and subject (its first
# line). Run once before the fold, for the skip test, and again after a fold.
# A CR is stripped so it cannot survive into the subject, where it would defeat
# the trailing-period test and count against the cap. Leading blank lines are
# dropped so that the subject and the body agree on which physical line is
# which: taking the subject as the first non-blank line while taking the
# separator by line number desynchronises them, and a message that opens with
# a blank line then fails a body rule it does not break.
read_message() {
  body_all="$(awk -v cc="$comment_char" '
    /^diff --git /            { exit }
                              { sub(/\r$/, "") }
    index($0, cc cc) == 1     { print; next }
    index($0, cc) == 1        { next }
                              { print }
  ' "$msg_file")"
  body_all="$(printf '%s\n' "$body_all" | awk 'NF == 0 && !seen { next } { seen = 1; print }')"
  subject="$(printf '%s\n' "$body_all" | awk 'NR == 1')"
}
read_message
[ -n "$subject" ] || exit 0

# fixup!/squash!/amend! and Reapply "…" are prefixes git itself generates, so
# they are genuine text markers. Reapply is over the cap by construction for
# any original subject of 63 characters or more. Tested before the fold, so a
# skipped message is never rewritten either.
case "$subject" in
  fixup!*|squash!*|amend!*|Reapply\ \"*) exit 0 ;;
esac

# --- Body fold -------------------------------------------------------------

# The wrap cap is the one rule a hook can repair rather than reject. Each plain
# prose line past the cap is re-broken on its own, greedily at the cap; it is
# never joined with the lines around it, so a paragraph of deliberate short
# lines ("Before: 3 calls" over "After: 1 call") keeps its breaks, and the only
# change is a newline where a lone space was inside the over-long line (a run
# of spaces, or a tab, is kept as written). Left alone, so the wrap check below
# still sees them: the subject, git's comments, a verbose diff from its first
# diff line down, any paragraph holding a line git parses as a trailer,
# indented lines, lines inside a ``` or ~~~ fence, list items, `>` quotes, `|`
# table rows, headings, and a line with no space at or before the cap (a URL
# or other unbreakable token) or no lone space to break at.
#
# A break never lands before a word opening with the comment string: under
# cleanup mode strip (any commit that opens an editor) git deletes that line
# after this hook runs. Such a word stays on the line with the word before it.
#
# A trailer is what git says is a trailer, not a pattern that guesses: an older
# test matched any "Word: " opener, so an ordinary paragraph beginning "Note: "
# or "Why: " was silently exempt from the wrap rule.
trailers="$(git interpret-trailers --parse < "$msg_file" 2>/dev/null || true)"
nl=$'\n'
re_fence='^[[:space:]]*(```|~~~)'
re_list='^([-*+]|[0-9]+[.)])[[:space:]]'
re_quote='^[>|]'
re_heading='^#{1,6}[[:space:]]'

is_trailer() {
  case "$nl$trailers$nl" in *"$nl$1$nl"*) return 0 ;; esac
  return 1
}
# Over the cap with a space at or before it, so a break point exists. No
# pipeline: under pipefail a SIGPIPE from an early grep exit would misread.
over_cap_breakable() {
  [ ${#1} -gt "$WRAP" ] || return 1
  case "${1:0:$((WRAP + 1))}" in *' '*) return 0 ;; esac
  return 1
}

raw=() kind=() para=()
p=0 seen_subject=0 in_fence="" below_cut=0 protected=" "
while IFS= read -r line || [ -n "$line" ]; do
  raw+=("$line")
  l="${line%$'\r'}"
  k=keep
  if [ "$below_cut" -eq 1 ]; then
    :
  elif [[ "$l" == "diff --git "* ]]; then
    below_cut=1
  elif [[ "$l" == "$comment_char"* ]]; then
    :
  elif [ -z "${l//[[:space:]]/}" ]; then
    k=blank; p=$((p + 1))
  elif [ "$seen_subject" -eq 0 ]; then
    seen_subject=1
  elif [[ "$l" =~ $re_fence ]]; then
    # A fence closes only on the marker that opened it, so a ``` inside a
    # ~~~ block is a line of that block.
    if [ -z "$in_fence" ]; then in_fence="${BASH_REMATCH[1]}"
    elif [ "$in_fence" = "${BASH_REMATCH[1]}" ]; then in_fence=""
    fi
  elif [ -n "$in_fence" ] || [[ "$l" =~ ^[[:space:]] || "$l" =~ $re_list || "$l" =~ $re_quote || "$l" =~ $re_heading ]]; then
    :
  else
    k=prose
    is_trailer "$l" && protected="$protected$p "
  fi
  kind+=("$k"); para+=("$p")
done < "$msg_file"

folded=0
out=()
for i in "${!raw[@]}"; do
  l="${raw[$i]%$'\r'}"
  if [ "${kind[$i]}" != prose ] || [[ "$protected" == *" ${para[$i]} "* ]] || ! over_cap_breakable "$l"; then
    out+=("${raw[$i]}"); continue
  fi
  # Units, not words: the line splits at each single space, and a field that
  # is empty (a run of spaces) or opens with the comment string is glued back
  # to the one before it, so a break lands only at a lone space and never in
  # front of a comment-string word. A tab never splits. Every byte but the
  # space a newline replaces survives.
  fields=() rest="$l"
  while [[ "$rest" == *' '* ]]; do fields+=("${rest%% *}"); rest="${rest#* }"; done
  fields+=("$rest")
  units=()
  for j in "${!fields[@]}"; do
    w="${fields[$j]}"
    if [ "$j" -gt 0 ] && { [ -z "$w" ] || [ -z "${fields[$((j - 1))]}" ] || [[ "$w" == "$comment_char"* ]]; }; then
      units[${#units[@]} - 1]="${units[${#units[@]} - 1]} $w"
    else
      units+=("$w")
    fi
  done
  pieces=() cur=""
  for w in "${units[@]}"; do
    if [ -z "$cur" ]; then cur="$w"
    elif [ $(( ${#cur} + 1 + ${#w} )) -le "$WRAP" ]; then cur="$cur $w"
    else pieces+=("$cur"); cur="$w"
    fi
  done
  pieces+=("$cur")
  # A line whose only spaces sit in runs has no break point: it stays whole
  # and uncounted, for the wrap check below to reject.
  if [ "${#pieces[@]}" -eq 1 ]; then
    out+=("${raw[$i]}"); continue
  fi
  folded=$((folded + 1))
  out+=("${pieces[@]}")
done

# Written back only when something folded, so an untouched message keeps its
# exact bytes. The folded text goes to a temp file beside the message and is
# moved over it, so a write that fails partway leaves the original whole; the
# template sits beside the message rather than under TMPDIR so the mv is a
# rename on one filesystem (scripts/README.md § Temp files names the general
# rule). A failed write leaves the long lines for the check below to reject:
# this hook fails closed (ADR-0067).
if [ "$folded" -gt 0 ]; then
  if fold_tmp="$(mktemp "$msg_file.fold.XXXXXX" 2>/dev/null)" && [ -f "$fold_tmp" ] &&
     printf '%s\n' "${out[@]}" > "$fold_tmp" && mv -f "$fold_tmp" "$msg_file"; then
    echo "commit-msg: folded $folded body lines past $WRAP columns" >&2
    read_message
  else
    [ -n "${fold_tmp:-}" ] && rm -f "$fold_tmp"
    echo "commit-msg: could not write the folded message back to $msg_file (temp file $msg_file.fold.XXXXXX) — nothing was changed" >&2
  fi
fi

# --- Subject ---------------------------------------------------------------

n=${#subject}
if [ "$n" -gt "$WRAP" ]; then
  echo "commit-msg: FAIL subject is $n chars, over the $WRAP hard cap (aim $AIM) — $STYLE $SUBJECT_ANCHOR" >&2
  fail=1
fi

case "$subject" in
  *.) echo "commit-msg: FAIL subject ends with a period — $STYLE $SUBJECT_ANCHOR" >&2; fail=1 ;;
esac

# Conventional Commits prefix, unless the repo declares that convention. The
# alternation is the CC type set: a bare "note: " or "todo: " is ordinary prose
# and must not be told it carries a prefix it does not carry.
declares_cc=0
for f in .commitlintrc .commitlintrc.json .commitlintrc.yml .commitlintrc.yaml \
         .commitlintrc.js commitlint.config.js commitlint.config.cjs commitlint.config.mjs \
         commitlint.config.ts .czrc; do
  [ -e "$f" ] && declares_cc=1
done
if [ "$declares_cc" -eq 0 ] &&
   printf '%s' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_/.-]+\))?!?: '; then
  echo "commit-msg: FAIL subject carries a Conventional Commits type prefix, which this repo does not declare — $STYLE $SUBJECT_ANCHOR" >&2
  fail=1
fi

# Imperative opener — heuristic, so a warning rather than a block. The probe in
# the style doc is "If applied, this commit will ___".
first_word="$(printf '%s' "$subject" | awk '{print $1}' | tr -d ',:')"
case "$first_word" in
  Added|Adds|Adding|Updated|Updates|Updating|Fixed|Fixes|Fixing|Changed|Changes|Changing|\
  Removed|Removes|Removing|Created|Creates|Creating|Deleted|Deletes|Deleting|\
  Refactored|Refactors|Refactoring|Implemented|Implements|Implementing|\
  Improved|Improves|Improving|Bumped|Bumps|Bumping|Moved|Moves|Moving|\
  Renamed|Renames|Renaming|Tagged|Tags|Tagging)
    echo "commit-msg: WARN subject opens with '$first_word' — an imperative verb leads, so it completes 'If applied, this commit will ___' ($STYLE)" >&2
    warn=1 ;;
esac

# --- Body ------------------------------------------------------------------

second="$(printf '%s\n' "$body_all" | awk 'NR == 2')"
body="$(printf '%s\n' "$body_all" | awk 'NR > 1' | sed -e '1{/^[[:space:]]*$/d;}')"

if [ -n "$(printf '%s' "$body" | tr -d '[:space:]')" ]; then
  # A body must be separated from the subject by a blank line.
  if [ -n "$(printf '%s' "$second" | tr -d '[:space:]')" ]; then
    echo "commit-msg: FAIL no blank line between subject and body — $STYLE $BODY_ANCHOR" >&2
    fail=1
  fi

  if printf '%s\n' "$body" | grep -qE '^[[:space:]]*(```|~~~)'; then
    echo "commit-msg: FAIL body contains a code fence — $STYLE $BODY_ANCHOR ('No code fences')" >&2
    fail=1
  fi

  # The style doc's rule is "Order the body, without headings" — all of them,
  # not a wordlist. A level-one heading never reaches here: the comment strip
  # above treats it as git's own comment.
  if printf '%s\n' "$body" | grep -qE '^[[:space:]]*#{2,6}[[:space:]]*[^[:space:]]'; then
    echo "commit-msg: FAIL body uses a markdown heading — $STYLE $BODY_ANCHOR ('Order the body, without headings')" >&2
    fail=1
  fi

  # Wrap at the cap, over what the fold above left. A trailer, and a line with
  # no space at or before the cap (an unbreakable URL or token), cannot wrap and
  # is exempt. Every offending line is reported, so one commit attempt shows
  # the whole list.
  while IFS= read -r line; do
    is_trailer "$line" && continue
    over_cap_breakable "$line" || continue
    echo "commit-msg: FAIL body line exceeds $WRAP columns and is not prose the hook folds (a list item, a quote or table row, an indented or fenced line, or the trailer paragraph): ${line:0:60}… — $STYLE $BODY_ANCHOR" >&2
    fail=1
  done <<< "$body"
fi

if [ "$fail" -ne 0 ]; then
  echo "commit-msg: commit rejected. Fix the message, or read $STYLE." >&2
  echo "commit-msg: This checks message SHAPE only — register and the tell catalog still need a read." >&2
  # A rejection inside a rebase leaves a detached HEAD mid-rebase, and git's own
  # suggestion (commit --amend) re-runs this check on the same message. Say so,
  # or the author loops on advice that cannot succeed.
  if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
    echo "commit-msg: a rebase is in progress and HEAD is detached — reword and continue," >&2
    echo "commit-msg: or 'git rebase --abort' to put the branch back." >&2
  fi
  exit 1
fi

[ "$warn" -ne 0 ] && echo "commit-msg: warnings only; commit allowed." >&2
exit 0
